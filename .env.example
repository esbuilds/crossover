# Qloo hackathon key (works only against https://hackathon.api.qloo.com)
QLOO_API_KEY=
# Claude Opus 5.5 for ranking, briefs, outreach, refine and verdicts; Haiku 5.5 for match validation and stand-ins
ANTHROPIC_API_KEY=
# Upstash Redis REST: the shared cache and the daily counters
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Qloo calls allowed per UTC day across all instances (default 300)
QLOO_DAILY_CAP=
# Optional: lets scripts/warm.ts keep its briefs off the per-visitor limit
WARM_TOKEN=
# Development only: force failure paths, any of qloo429,anthropic,novenues,noheatmap
CROSSOVER_FORCE=
